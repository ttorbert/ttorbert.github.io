---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { getProjects, type Project } from '../../data/projects';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  const { projects } = await getProjects();
  return entries.map((entry) => {
    const project = projects.find((p) => p.name.toLowerCase() === entry.id.toLowerCase());
    return { params: { slug: project?.name ?? entry.id }, props: { entry, project } };
  });
}

interface Props {
  entry: Awaited<ReturnType<typeof getCollection<'projects'>>>[number];
  project?: Project;
}
const { entry, project } = Astro.props;
const { Content } = await render(entry);

const title = entry.data.title ?? project?.title ?? entry.id;
const tagline = entry.data.tagline ?? project?.description ?? '';
const image = entry.data.image ?? project?.image ?? null;
const repoUrl = project?.url ?? `https://github.com/${site.githubUser}/${entry.id}`;
const updated = project?.updated.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
---
<Base title={`${title} — ${site.name}`} description={tagline || title}>
  <div class="wrap">
    <nav class="crumbs"><a href="/">← All projects</a></nav>

    <header class="hero">
      <h1>{title}</h1>
      {tagline && <p class="tagline">{tagline}</p>}
      <div class="buttons">
        {project?.homepage && <a class="btn primary" href={project.homepage}>Live demo →</a>}
        <a class:list={['btn', { primary: !project?.homepage }]} href={repoUrl}>View code on GitHub</a>
      </div>
      {
        project && (
          <ul class="meta">
            {project.language && <li>{project.language}</li>}
            {project.stars > 0 && <li>★ {project.stars}</li>}
            {updated && <li>Updated {updated}</li>}
            {project.topics.map((t) => (
              <li class="topic">{t}</li>
            ))}
          </ul>
        )
      }
    </header>

    {image && <img class="hero-img" src={image} alt={`Screenshot of ${title}`} />}

    <article class="prose">
      <Content />
    </article>

    <footer>
      <a href="/">← Back to all projects</a>
      <a href={repoUrl}>GitHub →</a>
    </footer>
  </div>
</Base>

<style>
  .wrap {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding: 0 1rem;
  }
  @media (min-width: 640px) {
    .wrap {
      padding: 0 2rem;
    }
  }
  .crumbs {
    padding-top: 2rem;
    font-size: 0.9rem;
  }
  .crumbs a,
  footer a {
    color: var(--muted);
    text-decoration: none;
  }
  .crumbs a:hover,
  footer a:hover {
    color: var(--accent);
  }
  .hero {
    padding: clamp(2rem, 7vw, 3.5rem) 0 2rem;
  }
  h1 {
    margin: 0;
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .tagline {
    margin: 1rem 0 0;
    font-size: 1.15rem;
    color: var(--muted);
  }
  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }
  .btn {
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
  }
  .btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .btn.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }
  .btn.primary:hover {
    color: var(--bg);
    filter: brightness(1.1);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.1rem;
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .meta .topic {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.75rem;
    border: 1px solid var(--border);
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
  }
  .hero-img {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    margin-bottom: 2.5rem;
  }
  .prose {
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .prose :global(h2) {
    margin: 2.5rem 0 0.75rem;
    font-size: 1.4rem;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
  .prose :global(h3) {
    margin: 2rem 0 0.5rem;
    font-size: 1.15rem;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.1rem;
  }
  .prose :global(li) {
    margin-bottom: 0.35rem;
  }
  .prose :global(a) {
    color: var(--accent);
  }
  .prose :global(img) {
    max-width: 100%;
    border: 1px solid var(--border);
    border-radius: 10px;
    margin: 0.5rem 0;
  }
  .prose :global(blockquote) {
    margin: 1.5rem 0;
    padding: 0.25rem 0 0.25rem 1.25rem;
    border-left: 3px solid var(--accent);
    color: var(--muted);
  }
  .prose :global(code) {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.88em;
    padding: 0.1rem 0.35rem;
    border-radius: 6px;
    background: var(--accent-soft);
  }
  .prose :global(pre) {
    overflow-x: auto;
    padding: 1rem;
    border-radius: 10px;
    font-size: 0.88rem;
  }
  .prose :global(pre code) {
    background: none;
    padding: 0;
  }
  footer {
    display: flex;
    justify-content: space-between;
    margin-top: 3.5rem;
    padding: 2rem 0 3rem;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
  }
</style>
